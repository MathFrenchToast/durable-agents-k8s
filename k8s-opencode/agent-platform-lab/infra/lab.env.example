# Copy to infra/lab.env (done automatically by provision.sh if absent). Keep lab.env private.
LAB_ROOT=${LAB_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
LAB_NAME=agentlab
NETWORK=agentlab-net
BRIDGE=virbr-agentlab
SUBNET=192.168.124
SERVER_IP=192.168.124.10
WORKER_IP=192.168.124.11
SERVER_MAC=52:54:00:ab:10:10
WORKER_MAC=52:54:00:ab:10:11
VM_USER=ubuntu
SSH_PUBKEY_FILE=$LAB_ROOT/.private/ssh/id_ed25519.pub
SSH_PRIVKEY_FILE=$LAB_ROOT/.private/ssh/id_ed25519
KNOWN_HOSTS_FILE=$LAB_ROOT/.private/ssh/known_hosts
VM_RAM_MIB=8192
VM_VCPUS=4
SYSTEM_DISK_GIB=36
DATA_DISK_GIB=30
WORKDIR=$LAB_ROOT/.private/vms
# Ubuntu 24.04 guest cloud image (host can be Ubuntu 26.04)
CLOUD_IMAGE_URL=https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img
K3S_VERSION=v1.34.4+k3s1
LONGHORN_VERSION=1.13.0
OPENCODE_IMAGE=ghcr.io/anomalyco/opencode:2.0.0
